# AI Investment Monitor — environment variables
# Copy to .env and fill in values.
# On NixOS: use nixos/secrets.env.example + EnvironmentFile instead of this file.

# ── API Keys ──────────────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# ── Security (generate once, keep stable) ─────────────────────────────────────
# Fernet key — encrypts API keys stored in the database.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is auto-generated and saved to core/data/.encryption_key
ENCRYPTION_KEY=

# CSRF signing secret — any random string.
# Generate: openssl rand -hex 32
# If left blank, a value is auto-generated and saved to core/data/.csrf_secret
CSRF_SECRET_KEY=

# ── Web Server ────────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8443

# ── HTTPS (optional — skip if using Tailscale or a reverse proxy) ─────────────
# ENABLE_HTTPS=false
# Certificates expected at: certs/cert.pem and certs/key.pem

# ── Tuning ────────────────────────────────────────────────────────────────────
# DB_TIMEOUT=10
# PERPLEXITY_TIMEOUT=30
# GEMINI_TIMEOUT=60

# ── Development ───────────────────────────────────────────────────────────────
# DEV_MODE=false
# SLOW_QUERY_MS=200
