# Secrets for AI Investment Monitor — NixOS EnvironmentFile
#
# Copy to /etc/investment-monitor/secrets.env
# Then: chmod 600 /etc/investment-monitor/secrets.env
#       chown root /etc/investment-monitor/secrets.env
#
# Reference in your NixOS config:
#   services.investment-monitor.environmentFile =
#     "/etc/investment-monitor/secrets.env";
#
# Generate the two keys with:
#   nix-shell -p python3 --run \
#     "python3 -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""

# ── Required ──────────────────────────────────────────────────────────────────

# Fernet key used to encrypt API keys stored in the database.
# If this changes, all stored encrypted values become unreadable.
# Generate once and keep stable across rebuilds.
ENCRYPTION_KEY=

# Secret used to sign CSRF tokens.
# Any random string works — e.g. `openssl rand -hex 32`
CSRF_SECRET_KEY=

# ── Optional: pre-seed API keys ───────────────────────────────────────────────
# These can also be entered through the web UI after first login.
# Including them here means the scheduler can start immediately on first boot.

GEMINI_API_KEY=
PERPLEXITY_API_KEY=
